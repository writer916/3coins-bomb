{
  "rewrites": [
    {
      "source": "/api/duel/:path*",
      "destination": "/api/duel"
    },
    {
      "source": "/api/group/:path*",
      "destination": "/api/group"
    },
    {
      "source": "/duel/:matchId",
      "destination": "/index.html"
    },
    {
      "source": "/group/:groupId",
      "destination": "/index.html"
    }
  ]
}
